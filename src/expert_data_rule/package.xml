<?xml version="1.0"?>
<package format="2">
  <name>expert_data_rule</name>
  <version>0.1.0</version>
  <description>Continuous rule-based expert data collection for underwater ObjectNav.</description>
  <maintainer email="root@todo.todo">Aquaflow</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>cv_bridge</depend>
  <depend>data_generate</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>robot_control</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>stonefish_ros</depend>
  <exec_depend>aquaflow_stonefish</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
